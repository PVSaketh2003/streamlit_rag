# Copy to backend/.env for local development. Never commit .env.
# On Render, set the same names under the janani service → Environment.

# Chat model — either one:
#   Groq key (starts with gsk_, console.groq.com):
GROQ_API_KEY=
#   or xAI Grok key (starts with xai-, console.x.ai):
# XAI_API_KEY=
# Optional model overrides (empty = best available model is picked automatically)
# GROQ_MODEL=
# GROK_MODEL=grok-4

# Embeddings (Google AI Studio key)
GEMINI_API_KEY=
# GEMINI_EMBED_MODEL=gemini-embedding-001
# EMBED_DIM=768

# --- Sign-in: email + password, then a one-time code emailed to the user ---
# Option A - Gmail SMTP (sends from EMAIL_HOST_USER). EMAIL_HOST_PASSWORD must be a Google *App Password*
# (Google Account > Security > 2-Step Verification > App passwords). Spaces are ignored.
# NOTE: Render's FREE web services block outbound SMTP (ports 25/465/587): SMTP needs a paid Render instance.
EMAIL_HOST_USER=pvsaketh1@gmail.com
EMAIL_HOST_PASSWORD=
# Option 0 (recommended) - Gmail API over HTTPS: sends from the real Gmail account and works on Render Free.
# Create an OAuth "Desktop app" client in Google Cloud, enable the Gmail API, publish the consent screen, then run
# `python3 janani/scripts/gmail_authorize.py` (it saves GMAIL_REFRESH_TOKEN for you). See janani/README.md.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# Option B - HTTPS email API (works on Render Free). Create a free Brevo account, verify the sender address, add the API key:
# BREVO_API_KEY=
# Optional
# OWNER_EMAIL=pvsaketh1@gmail.com        # this account inherits videos/chats created before sign-in existed
# ALLOWED_EMAILS=you@gmail.com,friend@example.com   # invite-only: only these can sign up / sign in (recommended in production)
# ALLOWED_EMAIL_DOMAINS=yourcompany.com
# Local development without any mail setup: leave EMAIL_HOST_PASSWORD empty and run with DJANGO_DEBUG=1 -
# the one-time code is then printed in the Django server log.

# --- production only (Render sets DATABASE_URL via the dashboard / render.yaml) ---
# DJANGO_SECRET_KEY=        # long random string, required when DJANGO_DEBUG is off
# DATABASE_URL=             # Postgres connection string
# API_RATE_LIMIT=240/min

# Optional: when YouTube blocks caption downloads from your IP
# YT_PROXY_URL=http://user:pass@host:port
