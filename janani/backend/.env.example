# Copy to backend/.env for local development. Never commit .env.
# On Render, set the same names under the janani service → Environment.

# Chat model — either one:
#   Groq key (starts with gsk_, console.groq.com):
GROQ_API_KEY=
#   or xAI Grok key (starts with xai-, console.x.ai):
# XAI_API_KEY=
# Optional model overrides (empty = best available model is picked automatically)
# GROQ_MODEL=
# GROK_MODEL=grok-4

# Embeddings (Google AI Studio key)
GEMINI_API_KEY=
# GEMINI_EMBED_MODEL=gemini-embedding-001
# EMBED_DIM=768

# --- production only (Render sets DATABASE_URL and DJANGO_SECRET_KEY via render.yaml) ---
# DJANGO_SECRET_KEY=        # long random string, required when DJANGO_DEBUG is off
# DATABASE_URL=             # Postgres connection string
# APP_ACCESS_TOKEN=         # access code people must enter to use the app (strongly recommended)
# API_RATE_LIMIT=240/min

# Optional: when YouTube blocks caption downloads (common from cloud IPs)
# YT_PROXY_URL=http://user:pass@host:port
